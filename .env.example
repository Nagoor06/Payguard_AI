# Generate a unique high-entropy key. Never commit your real .env.
APP_API_KEY=replace-with-a-long-random-value
REVIEWER_API_KEY=replace-with-a-different-long-random-value
DB_PASSWORD=replace-for-nonlocal-use
# demo mode runs with no AWS account. Bedrock mode calls a live AWS model and incurs charges.
AI_PROVIDER=demo
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS credentials should be supplied through a configured AWS profile or IAM role,
# not embedded in source files or .env committed to git.
